# Copia este archivo como .env y llena los valores. Sin comillas (docker --env-file no las quita).

# --- SQL Server ---
SQL_SERVER=servidor.dominio.local,1433
SQL_DATABASE=DataIA
SQL_USER=usuario_lectura
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_COMMAND_TIMEOUT=600

# --- Consultas ---
# Rutas relativas al directorio desde donde se ejecuta (en Docker: /app)
SQL_DIR=sql
OUTPUT_DIR=output
# Archivos a omitir, separados por coma
SQL_EXCLUDE=ventas.sql

# --- Google Drive (OAuth de usuario) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Se obtiene con: docker run --rm -it --env-file .env <imagen> auth
GOOGLE_REFRESH_TOKEN=
# El id que aparece en la URL: https://drive.google.com/drive/folders/<ESTE_ID>
DRIVE_FOLDER_ID=

# --- Salida ---
# Zona horaria para calcular la semana reportada (la imagen ya usa America/Mexico_City)
TZ=America/Mexico_City
